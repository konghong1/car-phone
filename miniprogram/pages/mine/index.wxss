/* 全局样式 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9ff 0%, #ffffff 100%);
}

.muted {
  color: #9ca3af;
  font-size: 24rpx;
}

/* 未登录状态 - 玻璃态卡片 */
.login-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
  background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
}

.login-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 80rpx 48rpx;
  text-align: center;
  box-shadow: 
    0 20rpx 60rpx rgba(102, 126, 234, 0.15),
    0 0 0 1rpx rgba(255, 255, 255, 0.5) inset;
  border: 1rpx solid rgba(102, 126, 234, 0.1);
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.3);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.welcome-text {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.login-btn {
  margin-top: 56rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border: none;
  border-radius: 24rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.login-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.25);
}

/* 已登录状态 */
.mine-container {
  padding-bottom: 40rpx;
}

/* 用户信息卡片 - 渐变背景 */
.user-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 48rpx;
  position: relative;
  overflow: hidden;
}

.user-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.user-info {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-right: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.user-details {
  flex: 1;
}

.nickname {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.user-id {
  font-size: 24rpx;
  opacity: 0.85;
  color: rgba(255, 255, 255, 0.9);
}

/* 统计数据卡片 - 玻璃态效果 */
.stats-card {
  margin: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 28rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 0 0 1rpx rgba(255, 255, 255, 0.5) inset;
  border: 1rpx solid rgba(102, 126, 234, 0.08);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 64rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
  line-height: 1;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}

.divider {
  width: 2rpx;
  height: 80rpx;
  background: linear-gradient(180deg, transparent 0%, #e5e7eb 50%, transparent 100%);
}

/* 功能菜单区域 */
.menu-section {
  margin: 0 32rpx 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.menu-list {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f3f4f6;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: linear-gradient(90deg, rgba(102, 126, 234, 0.05) 0%, transparent 100%);
}

.menu-item::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 100%;
  background: linear-gradient(90deg, rgba(102, 126, 234, 0.1) 0%, transparent 100%);
  transition: width 0.3s;
}

.menu-item:active::after {
  width: 100%;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-radius: 16rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.menu-arrow {
  font-size: 48rpx;
  color: #d1d5db;
  font-weight: 300;
  transition: all 0.2s;
}

.menu-item:active .menu-arrow {
  color: #667eea;
  transform: translateX(4rpx);
}

/* 退出登录按钮 */
.logout-section {
  margin: 48rpx 32rpx 32rpx;
}

.logout-btn {
  background: #ffffff;
  color: #ef4444;
  border: 2rpx solid #fecaca;
  border-radius: 24rpx;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.08);
  transition: all 0.2s;
}

.logout-btn:active {
  background: #fef2f2;
  border-color: #ef4444;
  transform: scale(0.98);
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 32rpx;
  margin-top: 16rpx;
}
