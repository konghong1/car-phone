<view class="page">
  <!-- 未登录状态 -->
  <view wx:if="{{!token}}" class="login-container">
    <view class="login-card">
      <view class="avatar-placeholder">👤</view>
      <view class="welcome-text">欢迎使用安心挪车</view>
      <view class="muted">登录后可以管理您的挪车二维码</view>
      <button class="login-btn" bindtap="login">微信登录</button>
    </view>
  </view>

  <!-- 已登录状态 -->
  <view wx:else class="mine-container">
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <view class="user-info">
        <view class="avatar">👤</view>
        <view class="user-details">
          <view class="nickname">{{userInfo.nickname || '微信用户'}}</view>
          <view class="user-id">ID: {{userInfo.id || '未获取'}}</view>
        </view>
      </view>
    </view>

    <!-- 统计数据 -->
    <view class="stats-card">
      <view class="stat-item">
        <view class="stat-value">{{stats.totalVehicles}}</view>
        <view class="stat-label">挪车码数量</view>
      </view>
      <view class="divider"></view>
      <view class="stat-item">
        <view class="stat-value">{{stats.totalCalls}}</view>
        <view class="stat-label">被呼叫次数</view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-section">
      <view class="section-title">快捷操作</view>
      <view class="menu-list">
        <view class="menu-item" bindtap="goToVehicles">
          <view class="menu-icon">🚗</view>
          <view class="menu-text">我的挪车码</view>
          <view class="menu-arrow">›</view>
        </view>
        <view class="menu-item" bindtap="goToCreate">
          <view class="menu-icon">➕</view>
          <view class="menu-text">新增挪车码</view>
          <view class="menu-arrow">›</view>
        </view>
      </view>
    </view>

    <view class="menu-section">
      <view class="section-title">帮助与支持</view>
      <view class="menu-list">
        <view class="menu-item" bindtap="viewHelp">
          <view class="menu-icon">❓</view>
          <view class="menu-text">使用帮助</view>
          <view class="menu-arrow">›</view>
        </view>
        <view class="menu-item" bindtap="contactSupport">
          <view class="menu-icon">📞</view>
          <view class="menu-text">联系客服</view>
          <view class="menu-arrow">›</view>
        </view>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-section">
      <button class="logout-btn" bindtap="logout">退出登录</button>
    </view>

    <!-- 版本信息 -->
    <view class="version-info">
      <text class="muted">安心挪车 v1.0.0</text>
    </view>
  </view>
</view>
