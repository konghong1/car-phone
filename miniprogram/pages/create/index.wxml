<view class="page">
  <!-- 表单页面 -->
  <view wx:if="{{!showQrcode}}" class="form-container">
    <view class="header">
      <view class="back-btn" bindtap="goBack">← 返回</view>
      <view class="title">创建挪车码</view>
    </view>

    <view class="panel">
      <!-- 车主档案信息卡片 -->
      <view class="profile-info-card">
        <view class="card-title">使用档案</view>
        <view class="info-row">
          <text class="label">昵称：</text>
          <text class="value">{{nickname}}</text>
        </view>
        <view class="info-row">
          <text class="label">车牌：</text>
          <text class="value plate">{{plateNo}}</text>
        </view>
        <view class="info-row">
          <text class="label">手机：</text>
          <text class="value phone">{{phone}}</text>
        </view>
      </view>

      <view class="form">
        <label>安慰语</label>
        <textarea value="{{form.comfortMessage}}" data-field="comfortMessage" bindinput="onInput" maxlength="80" placeholder="给扫码人看的礼貌提示"></textarea>

        <!-- 样式选择区域 -->
        <view class="style-section">
          <label>选择卡片风格</label>
          <view class="style-grid">
            <view wx:for="{{styleTemplates}}" wx:key="id" 
                  class="style-card {{cardStyle === item.id ? 'selected' : ''}}"
                  bindtap="selectStyle" 
                  data-style="{{item.id}}">
              <view class="style-icon">{{item.icon}}</view>
              <view class="style-name">{{item.name}}</view>
              <view class="style-preview" style="background: linear-gradient(135deg, {{item.colors[0]}} 0%, {{item.colors[1]}} 100%)"></view>
            </view>
          </view>
        </view>

        <!-- 自定义选项 -->
        <view class="custom-options">
          <label>显示车牌徽章</label>
          <switch checked="{{showPlateBadge}}" bindchange="togglePlateBadge" />
          
          <label>自定义文本（可选）</label>
          <input value="{{customText}}" data-field="customText" bindinput="onInput" placeholder="例如：临时停车，请多包涵" />
        </view>

        <view class="tip">
          <text class="tip-icon">💡</text>
          <text class="tip-text">温馨提示：每次创建都会生成一条新的挪车码记录，您可以为不同的车辆创建多个二维码。</text>
        </view>

        <button class="primary-btn" loading="{{submitting}}" bindtap="createVehicle">生成二维码</button>
      </view>
    </view>
  </view>

  <!-- 二维码展示页面 -->
  <view wx:else class="qrcode-container">
    <view class="qrcode-card">
      <view class="success-icon">✅</view>
      <view class="success-title">挪车码生成成功！</view>
      <view class="success-desc">保存或分享此二维码，贴于车窗即可使用</view>

      <view class="qrcode-box">
        <image class="qrcode-image" src="{{apiBase}}/api/vehicles/{{vehicleId}}/qrcode" mode="aspectFit"></image>
        <view class="qrcode-hint">微信扫码即可呼叫</view>
      </view>

      <view class="qrcode-actions">
        <button class="action-btn save-btn" bindtap="saveQrcode">
          <text class="btn-icon">💾</text>
          <text>保存到相册</text>
        </button>
        <button class="action-btn share-btn" bindtap="shareQrcode">
          <text class="btn-icon">📤</text>
          <text>分享给好友</text>
        </button>
        <button class="action-btn back-btn" bindtap="backToList">
          <text class="btn-icon">📋</text>
          <text>返回列表</text>
        </button>
      </view>
    </view>
  </view>
</view>
