<view class="container">
  <!-- 头部 -->
  <view class="header">
    <view class="title">车主档案</view>
    <view class="subtitle">选择档案查看贴图，或添加新档案</view>
  </view>

  <!-- 档案列表 -->
  <view class="profile-list" wx:if="{{profiles.length > 0}}">
    <view 
      class="profile-card" 
      wx:for="{{profiles}}" 
      wx:key="id"
      bindtap="selectProfile"
      bindlongpress="editProfile"
      data-profile="{{item}}"
    >
      <view class="card-main">
        <view class="info-row">
          <text class="nickname">{{item.nickname}}</text>
          <text class="plate-no" wx:if="{{item.plateNo}}">{{item.plateNo}}</text>
        </view>
        <view class="phone">{{item.phone}}</view>
      </view>
      
      <view class="card-right">
        <view class="sticker-count">查看贴图 ›</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && profiles.length === 0}}">
    <view class="empty-icon">📋</view>
    <view class="empty-text">暂无车主档案</view>
    <view class="empty-hint">点击下方按钮添加您的第一个档案</view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 添加按钮 -->
  <view class="add-button" bindtap="addProfile">
    <text class="plus">+</text>
    <text>添加新档案</text>
  </view>
</view>
