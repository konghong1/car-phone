<view class="container">
  <view class="form-card">
    <view class="form-title">{{editId ? '编辑档案' : '添加车主档案'}}</view>
    <view class="form-desc">请填写车主基本信息，可添加多个车牌</view>

    <view class="form-group">
      <view class="label">昵称 <text class="required">*</text></view>
      <input class="input" placeholder="如：王先生" value="{{nickname}}" data-field="nickname" bindinput="onInput" />
    </view>

    <!-- 车牌列表 -->
    <view class="vehicles-section">
      <view class="section-header">
        <view class="label">车辆信息</view>
        <view class="add-vehicle-btn" bindtap="addVehicle">
          <text class="plus">+</text>
          <text>添加车牌</text>
        </view>
      </view>
      
      <view class="vehicle-item" wx:for="{{vehicles}}" wx:key="id" wx:for-index="idx">
        <view class="vehicle-left">
          <view class="vehicle-label">车牌 {{idx + 1}}</view>
        </view>
        <view class="vehicle-remove" wx:if="{{vehicles.length > 1}}" bindtap="removeVehicle" data-index="{{idx}}">✕</view>
        <view class="vehicle-form">
          <view class="form-row">
            <input class="input plate-input" placeholder="车牌号 如:京A88888" value="{{item.plateNo}}" data-field="vehicle" data-index="{{idx}}" data-vfield="plateNo" bindinput="onInput" />
            <input class="input phone-input" type="number" maxlength="11" placeholder="手机号" value="{{item.phone}}" data-field="vehicle" data-index="{{idx}}" data-vfield="phone" bindinput="onInput" />
          </view>
        </view>
      </view>
    </view>

    <button class="submit-btn" loading="{{submitting}}" bindtap="submit">
      {{editId ? '保存修改' : '确认添加'}}
    </button>
  </view>
</view>
