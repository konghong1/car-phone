.container {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 40rpx 30rpx;
}

.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.form-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.form-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.form-group {
  margin-bottom: 36rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.required {
  color: #ff4d4f;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f5f7fb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.input:focus {
  border-color: #667eea;
  background: #f0f2ff;
}

/* 车辆信息区域 */
.vehicles-section {
  margin-bottom: 36rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.add-vehicle-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #667eea;
  font-weight: 600;
}

.plus {
  font-size: 28rpx;
  font-weight: bold;
}

.vehicle-item {
  background: #f8f9ff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.vehicle-label {
  font-size: 22rpx;
  color: #667eea;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.vehicle-remove {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fee2e2;
  color: #ef4444;
  border-radius: 50%;
  font-size: 24rpx;
}

.vehicle-form .form-row {
  display: flex;
  gap: 16rpx;
}

.plate-input {
  flex: 0 0 55%;
}

.phone-input {
  flex: 0 0 45%;
}

.submit-btn {
  margin-top: 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.submit-btn:active {
  opacity: 0.85;
}
