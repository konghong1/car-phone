.container {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 40rpx 30rpx;
}

.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.form-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.form-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.form-group {
  margin-bottom: 36rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.required {
  color: #ff4d4f;
}

.optional {
  color: #bbb;
  font-size: 24rpx;
  font-weight: normal;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f5f7fb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.input:focus {
  border-color: #667eea;
  background: #f0f2ff;
}

.submit-btn {
  margin-top: 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.submit-btn:active {
  opacity: 0.85;
}
