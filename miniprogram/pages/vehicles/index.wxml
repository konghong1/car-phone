<view class="page">
  <!-- 车主信息卡片 -->
  <view class="owner-card">
    <view class="owner-header">
      <view class="owner-avatar">👤</view>
      <view class="owner-info">
        <view class="owner-name">{{ownerInfo.nickname || '未设置昵称'}}</view>
        <view class="owner-phone" bindtap="editOwnerInfo">
          <text>{{ownerInfo.phone || '点击设置手机号'}}</text>
          <text class="edit-icon">✏️</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 车辆列表标题 -->
  <view class="section-header">
    <view class="section-title">我的车辆 ({{vehicleList.length}})</view>
    <button class="add-vehicle-btn" bindtap="goToAddVehicle">
      <text class="plus-icon">+</text>
      <text>添加车辆</text>
    </button>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{vehicleList.length === 0}}" class="empty-state">
    <view class="empty-icon">🚗</view>
    <view class="empty-text">还没有添加车辆</view>
    <view class="empty-desc">点击上方按钮添加您的第一辆车</view>
  </view>

  <!-- 车辆列表 -->
  <scroll-view wx:else class="vehicle-scroll" scroll-y>
    <view class="vehicle-list">
      <view wx:for="{{vehicleList}}" wx:key="vehicleId" 
            class="vehicle-item"
            bindtap="goToVehicleDetail"
            data-vehicle="{{item}}">
        
        <!-- 车辆信息 -->
        <view class="vehicle-main">
          <view class="plate-badge">{{item.plateNo || '未填车牌'}}</view>
          <view class="vehicle-meta">
            <text class="meta-item">👤 {{item.ownerName}}</text>
            <text class="meta-item">📱 {{item.phone}}</text>
          </view>
        </view>

        <!-- 卡片数量 -->
        <view class="card-count">
          <view class="count-number">{{item.cards.length}}</view>
          <view class="count-label">个贴图</view>
          <view class="arrow">›</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
