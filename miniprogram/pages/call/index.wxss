/* 呼叫页面 - 温馨友好设计 */
.call-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

/* ========== 加载中 ========== */
.loading-container {
  text-align: center;
  color: #ffffff;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  font-weight: 600;
  opacity: 0.9;
}

/* ========== 呼叫卡片 ========== */
.call-container {
  width: 100%;
  max-width: 680rpx;
}

.call-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  animation: slideUp 0.5s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 车牌号区域 */
.plate-section {
  text-align: center;
  margin-bottom: 40rpx;
}

.plate-label {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.plate-number {
  display: inline-block;
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 800;
  border-radius: 20rpx;
  box-shadow: 
    0 8rpx 24rpx rgba(59, 130, 246, 0.3),
    0 0 0 3rpx rgba(255, 255, 255, 0.3) inset;
  letter-spacing: 2rpx;
}

/* 安慰语盒子 */
.message-box {
  position: relative;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border-left: 4rpx solid #667eea;
}

.quote-icon {
  position: absolute;
  font-size: 80rpx;
  color: rgba(102, 126, 234, 0.15);
  font-family: Georgia, serif;
  line-height: 1;
}

.quote-icon:first-child {
  top: 8rpx;
  left: 16rpx;
}

.quote-icon.end {
  bottom: -8rpx;
  right: 16rpx;
}

.message-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.8;
  text-align: justify;
  font-weight: 500;
}

/* 车主信息 */
.owner-info {
  background: #f9fafb;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 500;
}

.info-value {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
}

.phone-number {
  color: #667eea;
  font-family: 'Courier New', monospace;
  font-size: 30rpx;
}

/* 呼叫按钮 */
.call-btn {
  width: 100%;
  height: 104rpx;
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: #ffffff;
  border: none;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 32rpx rgba(239, 68, 68, 0.4);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.call-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s;
}

.call-btn:active::before {
  left: 100%;
}

.call-btn:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(239, 68, 68, 0.35);
}

.call-btn[disabled] {
  background: #d1d5db;
  box-shadow: none;
  opacity: 0.6;
}

.call-icon {
  font-size: 44rpx;
  animation: ring 1.5s ease-in-out infinite;
}

@keyframes ring {
  0%, 100% { transform: rotate(0); }
  10%, 30% { transform: rotate(-15deg); }
  20%, 40% { transform: rotate(15deg); }
  50% { transform: rotate(0); }
}

.call-text {
  letter-spacing: 1rpx;
}

/* 温馨提示 */
.tip-box {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx;
  background: rgba(251, 191, 36, 0.1);
  border-radius: 16rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.2);
}

.tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
  font-weight: 500;
}
