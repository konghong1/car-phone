.container {
  min-height: 100vh;
  background: #f5f7fb;
  padding-bottom: 40rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 贴图展示 */
.sticker-display {
  width: 100%;
  height: 600rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.sticker-img {
  width: 100%;
  height: 100%;
}

.sticker-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  width: 100%;
  height: 100%;
}

.placeholder-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.placeholder-text {
  color: #fff;
  font-size: 30rpx;
}

/* 信息卡片 */
.info-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.info-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.label {
  width: 120rpx;
  color: #999;
  flex-shrink: 0;
}

.value {
  color: #333;
  flex: 1;
}

.value.plate {
  color: #667eea;
  font-weight: 600;
}

.value.msg {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 二维码区域 */
.qrcode-section {
  margin: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.qrcode-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.qrcode-img {
  width: 300rpx;
  height: 300rpx;
}

/* 操作按钮 */
.action-bar {
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  border: none;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
}

.action-btn.secondary {
  background: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
}

.action-btn.danger {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ffccc7;
}

.action-btn:active {
  opacity: 0.8;
}

/* 空状态 */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
