<view class="container">
  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading && sticker}}">
    <!-- 贴图展示 -->
    <view class="sticker-display">
      <image class="sticker-img" src="{{sticker.finalImageUrl}}" mode="aspectFit" wx:if="{{sticker.finalImageUrl}}"></image>
      <view class="sticker-placeholder" wx:else>
        <text class="placeholder-icon">🎨</text>
        <text class="placeholder-text">贴图预览</text>
      </view>
    </view>

    <!-- 信息卡片 -->
    <view class="info-card">
      <view class="info-title">贴图信息</view>
      <view class="info-row">
        <text class="label">车主</text>
        <text class="value">{{sticker.ownerName}}</text>
      </view>
      <view class="info-row" wx:if="{{sticker.plateNo}}">
        <text class="label">车牌</text>
        <text class="value plate">{{sticker.plateNo}}</text>
      </view>
      <view class="info-row">
        <text class="label">电话</text>
        <text class="value">{{sticker.maskedPhone}}</text>
      </view>
      <view class="info-row" wx:if="{{sticker.comfortMessage}}">
        <text class="label">问候语</text>
        <text class="value msg">{{sticker.comfortMessage}}</text>
      </view>
    </view>

    <!-- 二维码 -->
    <view class="qrcode-section">
      <view class="qrcode-title">扫码呼叫二维码</view>
      <image class="qrcode-img" src="{{apiBase}}/api/vehicles/{{stickerId}}/qrcode" mode="aspectFit"></image>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <button class="action-btn primary" bindtap="downloadSticker">
        <text>下载贴图</text>
      </button>
      <button class="action-btn secondary" bindtap="downloadQrcode">
        <text>下载二维码</text>
      </button>
      <button class="action-btn danger" bindtap="deleteSticker">
        <text>删除贴图</text>
      </button>
    </view>
  </block>

  <!-- 不存在 -->
  <view class="empty-state" wx:if="{{!loading && !sticker}}">
    <text class="empty-text">贴图不存在</text>
  </view>
</view>
