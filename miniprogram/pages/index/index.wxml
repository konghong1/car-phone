<view class="page">
  <view class="panel">
    <view class="title">车主挪车码</view>
    <view class="muted intro">登录后填写联系方式，生成二维码贴在车上。对方扫码后会先看到安慰语，再选择是否呼叫。</view>

    <button wx:if="{{!token}}" class="primary-btn" bindtap="login">微信登录</button>

    <view wx:else class="form">
      <label>车主称呼</label>
      <input value="{{form.ownerName}}" data-field="ownerName" bindinput="onInput" placeholder="例如：王先生" />

      <label>车牌号</label>
      <input value="{{form.plateNo}}" data-field="plateNo" bindinput="onInput" placeholder="例如：沪A12345" />

      <label>手机号</label>
      <input value="{{form.phone}}" data-field="phone" bindinput="onInput" type="number" maxlength="11" placeholder="用于扫码后拨号" />

      <label>安慰语</label>
      <textarea value="{{form.comfortMessage}}" data-field="comfortMessage" bindinput="onInput" maxlength="80" placeholder="给扫码人看的礼貌提示"></textarea>

      <button class="primary-btn" loading="{{submitting}}" bindtap="createVehicle">生成二维码</button>
    </view>
  </view>

  <view wx:if="{{vehicle}}" class="panel result">
    <view class="result-title">{{vehicle.plateNo || "挪车联系码"}}</view>
    <image class="qr" src="{{apiBase + vehicle.qrCodeUrl}}" mode="aspectFit"></image>
    <view class="muted">扫码后展示：{{vehicle.comfortMessage}}</view>
    <button class="secondary-btn" bindtap="previewCallPage">预览扫码页</button>
  </view>
</view>
