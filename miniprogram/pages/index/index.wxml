<view class="page">
  <!-- 未登录状态 -->
  <view wx:if="{{!token}}" class="login-container">
    <view class="login-card">
      <view class="login-icon">🚗</view>
      <view class="login-title">安心挪车码</view>
      <view class="login-desc">创建专属挪车二维码，保护隐私又便捷</view>
      <button class="login-btn" loading="{{loading}}" bindtap="login">
        <text class="btn-text">微信一键登录</text>
      </button>
    </view>
  </view>

  <!-- 已登录状态 -->
  <view wx:else class="content">
    <!-- 顶部操作栏 -->
    <view class="header-section">
      <view class="header-title">我的挪车码</view>
      <button class="create-btn" bindtap="goToCreate">
        <text class="plus-icon">+</text>
        <text>新建</text>
      </button>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{vehicleList.length === 0}}" class="empty-state">
      <view class="empty-icon-box">
        <text class="empty-emoji">📱</text>
      </view>
      <view class="empty-title">还没有挪车码</view>
      <view class="empty-desc">点击右上角"新建"按钮，3步生成您的专属挪车码</view>
    </view>

    <!-- 车辆列表 -->
    <scroll-view wx:else class="vehicle-scroll" scroll-y>
      <view class="vehicle-grid">
        <view wx:for="{{vehicleList}}" wx:key="id" class="vehicle-card" bindtap="previewVehicle" data-id="{{item.id}}">
          <!-- 二维码预览区 -->
          <view class="card-qrcode" style="background: linear-gradient(135deg, {{item.backgroundColor || '#f8f9ff'}} 0%, {{item.themeColor || '#e8eaff'}}20 100%)">
            <image class="qrcode-img" src="{{apiBase}}/api/vehicles/{{item.id}}/qrcode" mode="aspectFit"></image>
            <view class="scan-hint">扫码呼叫</view>
          </view>
          
          <!-- 车辆信息 -->
          <view class="card-info">
            <view class="info-header">
              <text class="plate-badge" wx:if="{{item.showPlateBadge !== false}}" style="background: linear-gradient(135deg, {{item.themeColor || '#3b82f6'}} 0%, {{item.themeColor || '#2563eb'}}dd 100%)">{{item.plateNo || '未填车牌'}}</text>
              <text class="status-dot"></text>
            </view>
            <view class="info-row">
              <text class="info-label">车主</text>
              <text class="info-value">{{item.ownerName}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">电话</text>
              <text class="info-value phone-text">{{item.maskedPhone}}</text>
            </view>
            <view class="info-row" wx:if="{{item.cardStyle}}">
              <text class="info-label">风格</text>
              <text class="info-value style-tag">{{getStyleName(item.cardStyle)}}</text>
            </view>
          </view>

          <!-- 操作按钮 -->
          <view class="card-actions">
            <button class="action-btn delete-btn" catchtap="deleteVehicle" data-id="{{item.id}}">
              <text class="btn-icon">🗑️</text>
              <text>删除</text>
            </button>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
