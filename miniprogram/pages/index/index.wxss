/* 现代化列表页面 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
}

/* ========== 登录页面 ========== */
.login-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 40rpx;
  padding: 80rpx 48rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  text-align: center;
}

.login-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.login-title {
  font-size: 48rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s;
}

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.btn-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

/* ========== 已登录内容区 ========== */
.content {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9ff 0%, #ffffff 100%);
  padding-bottom: 40rpx;
}

/* 顶部操作栏 */
.header-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.create-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.create-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.plus-icon {
  font-size: 36rpx;
  font-weight: 700;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.empty-icon-box {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15rpx); }
}

.empty-emoji {
  font-size: 100rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
}

/* ========== 车辆列表 ========== */
.vehicle-scroll {
  height: calc(100vh - 200rpx);
  padding: 0 24rpx;
}

.vehicle-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340rpx, 1fr));
  gap: 24rpx;
}

/* 车辆卡片 */
.vehicle-card {
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 
    0 4rpx 16rpx rgba(0, 0, 0, 0.06),
    0 0 0 1rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.vehicle-card:active {
  transform: translateY(-4rpx);
  box-shadow: 
    0 12rpx 32rpx rgba(102, 126, 234, 0.2),
    0 0 0 2rpx rgba(102, 126, 234, 0.1);
}

/* 二维码区域 */
.card-qrcode {
  position: relative;
  height: 280rpx;
  background: linear-gradient(135deg, #f8f9ff 0%, #e8eaff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
}

.qrcode-img {
  width: 200rpx;
  height: 200rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.scan-hint {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  padding: 6rpx 16rpx;
  background: rgba(102, 126, 234, 0.9);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 12rpx;
  backdrop-filter: blur(10rpx);
}

/* 卡片信息区 */
.card-info {
  padding: 24rpx;
  background: #ffffff;
}

.info-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.plate-badge {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  background: #10b981;
  border-radius: 50%;
  box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.2);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 500;
}

.info-value {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
}

.phone-text {
  color: #667eea;
  font-family: 'Courier New', monospace;
}

.style-tag {
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  color: #667eea;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 8rpx;
}

/* 操作按钮 */
.card-actions {
  padding: 16rpx 24rpx;
  background: #fafafa;
  border-top: 1rpx solid #f3f4f6;
}

.action-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  background: transparent;
  border: none;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.delete-btn {
  color: #ef4444;
}

.delete-btn:active {
  background: rgba(239, 68, 68, 0.1);
}

.btn-icon {
  font-size: 28rpx;
}
