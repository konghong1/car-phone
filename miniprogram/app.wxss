page {
  background: #f5f7fb;
  color: #182238;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.panel {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(25, 38, 63, 0.08);
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.muted {
  color: #647089;
  font-size: 28rpx;
  line-height: 1.65;
}

.primary-btn {
  margin-top: 28rpx;
  background: #1677ff;
  color: #ffffff;
  border-radius: 10rpx;
  font-weight: 700;
}

.secondary-btn {
  margin-top: 20rpx;
  background: #edf3ff;
  color: #1464c8;
  border-radius: 10rpx;
  font-weight: 700;
}
